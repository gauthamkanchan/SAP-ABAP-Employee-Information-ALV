*&---------------------------------------------------------------------*
*& Report Z_VEN_CUSTALVREPORT
*&---------------------------------------------------------------------*
*& Employee Information ALV Report
*&---------------------------------------------------------------------*

REPORT Z_VEN_CUSTALVREPORT.

TABLES : ZIN_EMP01.

DATA : V TYPE ZIN_EMP01-EMPID.

SELECTION-SCREEN : BEGIN OF BLOCK A WITH FRAME.
SELECT-OPTIONS : S_EMPID FOR V.
SELECTION-SCREEN : END OF BLOCK A.

TYPES: BEGIN OF TY_FINAL,
         EMPID    TYPE ZIN_EMP01-EMPID,
         EMPNAME  TYPE ZIN_EMP01-EMPNAME,
         EMPFNAME TYPE ZIN_EMP01-EMPFNAME,
         EMPSAL   TYPE ZIN_EMP02-EMPSAL,
         EMPADD   TYPE ZIN_EMP02-EMPADD,
       END OF TY_FINAL.

DATA : WA_FINAL TYPE TY_FINAL,
       IT_FINAL TYPE TABLE OF TY_FINAL.

SELECT COUNT(*)
  FROM ZIN_EMP01
  INTO @DATA(LV_EMPID)
  WHERE EMPID IN @S_EMPID.

IF SY-SUBRC NE 0.
  MESSAGE 'EMPID NOT FOUND' TYPE 'I'.
ENDIF.

SELECT EMPID,
       EMPNAME,
       EMPFNAME
  FROM ZIN_EMP01
  INTO TABLE @DATA(IT_EMP01)
  WHERE EMPID IN @S_EMPID.

IF SY-SUBRC EQ 0 AND IT_EMP01 IS NOT INITIAL.

  SELECT EMPID,
         EMPSAL,
         EMPADD
    FROM ZIN_EMP02
    INTO TABLE @DATA(IT_EMP02)
    FOR ALL ENTRIES IN @IT_EMP01
    WHERE EMPID = @IT_EMP01-EMPID.

ENDIF.

LOOP AT IT_EMP01 INTO DATA(WA_EMP01).

  READ TABLE IT_EMP02 INTO DATA(WA_EMP02)
       WITH KEY EMPID = WA_EMP01-EMPID.

  WA_FINAL-EMPID    = WA_EMP01-EMPID.
  WA_FINAL-EMPNAME  = WA_EMP01-EMPNAME.
  WA_FINAL-EMPFNAME = WA_EMP01-EMPFNAME.
  WA_FINAL-EMPSAL   = WA_EMP02-EMPSAL.
  WA_FINAL-EMPADD   = WA_EMP02-EMPADD.

  APPEND WA_FINAL TO IT_FINAL.

ENDLOOP.

* Define field catalog

DATA : IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
       WA_FCAT TYPE SLIS_FIELDCAT_ALV.

WA_FCAT-FIELDNAME = 'EMPID'.
WA_FCAT-COL_POS = '1'.
WA_FCAT-SELTEXT_M = 'EMPLOYEEID'.
WA_FCAT-JUST = 'C'.
APPEND WA_FCAT TO IT_FCAT.

WA_FCAT-FIELDNAME = 'EMPNAME'.
WA_FCAT-COL_POS = '2'.
WA_FCAT-SELTEXT_M = 'EMPLOYEENAME'.
APPEND WA_FCAT TO IT_FCAT.

WA_FCAT-FIELDNAME = 'EMPFNAME'.
WA_FCAT-COL_POS = '3'.
WA_FCAT-SELTEXT_M = 'EMPLOYEE FATHERNAME'.
APPEND WA_FCAT TO IT_FCAT.

WA_FCAT-FIELDNAME = 'EMPSAL'.
WA_FCAT-COL_POS = '4'.
WA_FCAT-SELTEXT_M = 'EMPLOYEE SALARY'.
APPEND WA_FCAT TO IT_FCAT.

WA_FCAT-FIELDNAME = 'EMPADD'.
WA_FCAT-COL_POS = '5'.
WA_FCAT-SELTEXT_M = 'EMPLOYEE ADDRESS'.
APPEND WA_FCAT TO IT_FCAT.

DATA : IT_EVENT TYPE SLIS_T_EVENT,
       WA_EVENT LIKE LINE OF IT_EVENT.

WA_EVENT-NAME = 'TOP_OF_PAGE'.
WA_EVENT-FORM = 'TOP'.

APPEND WA_EVENT TO IT_EVENT.

CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
  EXPORTING
    I_CALLBACK_PROGRAM = 'SY-CPROG'
    IT_FIELDCAT        = IT_FCAT
    IT_EVENTS          = IT_EVENT
  TABLES
    T_OUTTAB           = IT_FINAL.

FORM TOP.

  DATA : IT_LIST TYPE TABLE OF SLIS_LISTHEADER,
         WA_LIST LIKE LINE OF IT_LIST.

  WA_LIST-INFO = 'This is employee details'.
  WA_LIST-TYP = 'A'.

  APPEND WA_LIST TO IT_LIST.

  CALL FUNCTION 'REUSE_ALV_COMMENTARY_WRITE'
    EXPORTING
      IT_LIST_COMMENTARY = IT_LIST.

ENDFORM.